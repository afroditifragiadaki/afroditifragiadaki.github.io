---
import { readout, links, photo } from '../data/projects.js';
---
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">Data science · Energy systems</p>
      <h1>Afroditi Fragkiadaki</h1>
      <p class="tagline">I turn messy energy data into <em>decisions.</em></p>
      <p class="lede">
        Electrical engineer turned analyst. I build forecasting models, dispatch
        optimizers and anomaly detectors. I like the math, and I like shipping
        something that actually gets used.
      </p>
      <div class="actions">
        <a class="btn primary" href="#experience">See my experience</a>
        <a class="btn" href="#work">Projects</a>
        <a class="btn" href={links.linkedin}>LinkedIn</a>
      </div>
    </div>
    <figure class="portrait">
      {photo
        ? <img src={photo} alt="Portrait of Afroditi Fragkiadaki" width="240" height="320" />
        : <span class="placeholder" aria-hidden="true">AF</span>}
    </figure>
  </div>
  <div class="wrap">
    <dl class="readout" aria-label="Project numbers">
      {readout.map((r) => (
        <div>
          <dt>{r.label}</dt>
          <dd>{r.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-bottom: 48px;
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 64px;
    align-items: center;
    padding-block: clamp(56px, 8vw, 96px);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .tagline {
    margin: 16px 0 0;
    font-size: clamp(1.375rem, 3vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--text);
  }
  .tagline em { font-style: normal; color: var(--green); }
  .lede {
    max-width: 54ch;
    margin: 20px 0 32px;
    font-size: 1.125rem;
    color: var(--muted);
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .portrait {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--mono);
    font-size: 3.5rem;
    color: var(--green);
  }
  .readout {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .readout div { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding: 16px 20px; }
  .readout div + div { border-left: 1px solid var(--line); }
  .readout dd { margin: 0; font-family: var(--mono); font-size: 1.375rem; color: var(--green); }
  .readout dt { font-size: 0.875rem; color: var(--muted); }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .portrait { width: min(240px, 100%); order: -1; }
    .readout { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .readout div:nth-child(3) { border-left: 0; }
    .readout div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>
